# ==========================================
# CivicFix Environment Configuration Template
# ==========================================

# -----------------
# Backend Config
# -----------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicfix_db
DB_USER=civicfix_user
DB_PASSWORD=civicfix_secure_password_change_in_prod

# JWT Authentication
# Must be at least 256 bits (32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origin
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Cloudinary Storage (Optional - falls back to local storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Upload Directory (used when Cloudinary is not configured)
UPLOAD_DIR=./uploads

# -----------------
# Frontend Config
# -----------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws
