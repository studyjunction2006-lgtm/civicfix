# CivicFix Monorepo Gitignore

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Java / Maven / Backend
backend/target/
backend/.mvn/wrapper/
backend/*.iml
backend/.idea/
backend/.vscode/
backend/.settings/
backend/.classpath
backend/.project
backend/uploads/
backend/*.log

# Environment & Credentials
.env
.env.local
*.pem
*.key
*.p12

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp
logs/
*.tmp
